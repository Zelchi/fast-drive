{
    "name": "backend",
    "version": "0.0.1",
    "description": "Fast Drive backend",
    "author": "",
    "private": true,
    "license": "UNLICENSED",
    "type": "commonjs",
    "scripts": {
        "build": "nest build",
        "deploy": "nest deploy",
        "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
        "start": "nest start",
        "start:dev": "nest start --watch",
        "start:debug": "nest start --debug --watch",
        "start:prod": "node dist/main.js",
        "db:generate": "drizzle-kit generate --config=drizzle.config.ts",
        "db:migrate": "drizzle-kit migrate --config=drizzle.config.ts",
        "db:push": "drizzle-kit push --config=drizzle.config.ts",
        "lint": "oxlint src/ test/",
        "test": "vitest run --passWithNoTests",
        "test:watch": "vitest",
        "test:cov": "vitest run --coverage --passWithNoTests",
        "test:debug": "vitest --inspect-brk --no-file-parallelism",
        "test:e2e": "vitest run --config ./vitest.config.e2e.ts --passWithNoTests"
    },
    "dependencies": {
        "@fast-drive/auth": "0.0.0",
        "@fast-drive/file-models": "0.0.0",
        "@fast-drive/shared-types": "0.0.0",
        "@nestjs/common": "^12.0.1",
        "@nestjs/core": "^12.0.1",
        "@nestjs/observe": "^0.1.8",
        "@nestjs/platform-express": "^12.0.1",
        "@libsql/client": "^0.18.0",
        "drizzle-orm": "^0.45.2",
        "dotenv": "^17.4.2",
        "reflect-metadata": "^0.2.2",
        "rxjs": "^7.8.1",
        "tslib": "^2.3.0",
        "zod": "^4.0.0"
    },
    "devDependencies": {
        "@nestjs/cli": "^12.0.0",
        "@nestjs/mau": "^0.2.6",
        "@nestjs/schematics": "^12.0.0",
        "@nestjs/testing": "^12.0.1",
        "@types/express": "^5.0.0",
        "@types/multer": "^2.2.0",
        "@types/node": "^24.0.0",
        "@types/supertest": "^7.0.0",
        "@vitest/coverage-v8": "^4.1.2",
        "drizzle-kit": "^0.31.10",
        "oxlint": "^1.58.0",
        "prettier": "^3.4.2",
        "source-map-support": "^0.5.21",
        "supertest": "^7.0.0",
        "typescript": "^6.0.2",
        "vitest": "^4.1.2"
    }
}
